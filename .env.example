# 로컬 실행용 환경변수 예시.
# GitHub Actions에서는 Secrets/Variables로 주입되므로 이 파일은 로컬 전용입니다.
# 실제 키/URL을 채운 사본을 만들어 쓰고, 절대 커밋하지 마세요.

# --- 한국투자증권(KIS) Open API — fetch_current.py (Actions에서는 Secrets) ---
KIS_APP_KEY=
KIS_APP_SECRET=
# 토큰 캐시 파일 경로 (선택, 기본: 시스템 임시 디렉터리)
#KIS_AUTH_CACHE_PATH=

# --- 프록시 히스토리 API — fetch_data.py (Actions에서는 저장소 Variables) ---
# 미설정 시 프록시 백필 비활성
PROXY_HISTORY_BASE_URL=

# --- 내부망 보조 API (로컬 실행 시에만, 미설정 시 해당 소스 비활성) ---
# fetch_data.py / fetch_current.py 공용
INTERNAL_CLOSE_API_URL=
INTERNAL_DAILY_API_URL=
INTERNAL_INDICES_API_URL=
# fetch_data.py 전용
INTERNAL_DIVIDENDS_API_URL=
# fetch_current.py 전용
INTERNAL_FX_API_URL=
INTERNAL_COMMODITIES_API_URL=
